# KudiTrack migration — LOCAL ONLY configuration.
#
# Copy to `.env` in this folder and fill in. `.env` is git-ignored by the repo
# root .gitignore (`.env` / `.env.*`) — never commit it, never paste its
# contents into a chat, an issue, or any AI tool. Every value below stays on
# your machine; no script here transmits them anywhere except to the two
# Supabase endpoints you name.
#
#   chmod 600 .env
#
# ---------------------------------------------------------------------------
# SOURCE = the existing Lovable Cloud project. READ-ONLY for every script here.
# ---------------------------------------------------------------------------
# Where to get these: Lovable → Cloud → the connection details you already hold.
# The source ref is pinned in the code as a safety guard (see PROD_REF below).
SRC_DB_URL="postgresql://postgres:PASSWORD@db.SOURCE-REF.supabase.co:5432/postgres"
SRC_URL="https://SOURCE-REF.supabase.co"
SRC_SERVICE_KEY="SOURCE-SERVICE-ROLE-KEY"

# ---------------------------------------------------------------------------
# TARGET = your NEW external Supabase project. The only thing written to.
# ---------------------------------------------------------------------------
# 1. Project Ref
#    Supabase Dashboard → your new project → Project Settings → General →
#    "Reference ID" (20 lowercase letters, e.g. abcdefghijklmnopqrst).
DST_REF="NEW-PROJECT-REF"

# 2. Database connection string
#    Project Settings → Database → Connection string → URI.
#    Use the *direct* connection (port 5432), not the pooler (6543): the import
#    needs session-level settings and multi-statement transactions.
#    Replace [YOUR-PASSWORD] with the database password you set when creating
#    the project (Settings → Database → Reset database password if lost).
DST_DB_URL="postgresql://postgres:PASSWORD@db.NEW-PROJECT-REF.supabase.co:5432/postgres"

# 3. Service-role key  (secret — server-side only, never in a browser bundle)
#    Project Settings → API Keys → `service_role` → Reveal → Copy.
DST_SERVICE_KEY="NEW-SERVICE-ROLE-KEY"

# 4. Anon / publishable key (public — safe in the browser, used by pg_cron)
#    Project Settings → API Keys → `anon` / `publishable`.
DST_ANON_KEY="NEW-ANON-KEY"

# 5. Supabase Personal Access Token (for the CLI: function deploys + secrets)
#    https://supabase.com/dashboard/account/tokens → "Generate new token".
#    Scope it to yourself, store it in your password manager, revoke after the
#    migration if you do not need it again.
SUPABASE_ACCESS_TOKEN="sbp_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# ---------------------------------------------------------------------------
# Edge-function secrets to set on the TARGET (step 16). Leave blank to skip one.
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_TRANSPORT="direct"            # direct = call api.resend.com, no gateway
SENDER_DOMAIN="mail.kuditrack.online"
PUBLIC_APP_URL="https://kuditrack.online"
APP_PUBLIC_URL="https://kuditrack.online"
STATEMENTS_CRON_SECRET=""
PAYSTACK_SECRET_KEY=""
AT_USERNAME=""
AT_API_KEY=""
AT_SENDER_ID=""
AT_ALLOW_SANDBOX="false"
SMS_ENABLED="true"
SUPER_ADMIN_SMS_PHONE=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""
AI_PROVIDER="disabled"              # no Lovable AI Gateway, no Anthropic

# ---------------------------------------------------------------------------
# Behaviour flags
# ---------------------------------------------------------------------------
DRY_RUN="1"                         # 1 = preflight only, writes nothing. Set to 0 to import.
EXPORT_DIR=""                       # leave blank to create a fresh timestamped dump
